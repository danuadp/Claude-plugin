{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "description": "Block git hook bypass flags (--no-verify, core.hooksPath override)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT:-.}/scripts/hooks/block-no-verify.js\""
          }
        ]
      }
    ]
  }
}
