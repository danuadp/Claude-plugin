{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "claude-plugin",
  "displayName": "Claude Plugin",
  "version": "0.2.0",
  "description": "Reads PDF, Word, PowerPoint and Excel files as Markdown, including legacy .doc/.ppt and scanned PDFs that need OCR. Also a starter plugin: one skill, one agent, one hook, and a bundled MCP server, wired up end to end.",
  "author": {
    "name": "danuadp",
    "url": "https://github.com/danuadp"
  },
  "repository": "https://github.com/danuadp/Claude-plugin",
  "license": "MIT",
  "keywords": [
    "documents",
    "pdf",
    "docx",
    "xlsx",
    "ocr",
    "markitdown",
    "starter"
  ],
  "mcpServers": {
    "markitdown": {
      "command": "${CLAUDE_PLUGIN_ROOT}/scripts/markitdown-mcp.sh",
      "env": {
        "MARKITDOWN_ENABLE_PLUGINS": "false"
      }
    }
  }
}
