{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "claude-plugin",
  "displayName": "Claude Plugin",
  "version": "0.1.0",
  "description": "Starter Claude Code plugin with a skill, an agent, and a hook wired up end to end.",
  "author": {
    "name": "danuadp",
    "url": "https://github.com/danuadp"
  },
  "repository": "https://github.com/danuadp/Claude-plugin",
  "license": "MIT",
  "keywords": [
    "starter",
    "template"
  ],
  "mcpServers": {
    "markitdown": {
      "command": "${CLAUDE_PLUGIN_ROOT}/scripts/markitdown-mcp.sh",
      "env": {
        "MARKITDOWN_ENABLE_PLUGINS": "false"
      }
    }
  }
}
